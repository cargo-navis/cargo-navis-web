{
  "name": "cargo-navis-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:sw": "node ./infra/inject-env-sw.js",
    "dev": "npm run build:sw && next dev --webpack",
    "dev:driverMock": "NEXT_PUBLIC_DRIVER_API_MOCK=true npm run dev --",
    "build": "npm run build:sw && next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "typecheck": "tsc --noEmit --incremental false --tsBuildInfoFile null",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/hooks": "^7.11.2",
    "@tabler/icons-react": "3.41.1",
    "@tanstack/react-query": "^5.53.3",
    "@tanstack/react-query-devtools": "^5.53.3",
    "@tanstack/react-table": "^8.17.3",
    "axios": "^1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "dayjs": "^1.11.11",
    "lodash": "^4.17.21",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "1.4.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/lodash": "^4.17.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "dotenv": "^17.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "postcss": "^8",
    "prettier": "^3.5.1",
    "tailwindcss": "4.3.4",
    "typescript": "^5",
    "vitest": "5.0.4"
  }
